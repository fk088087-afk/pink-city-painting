"%0APainting: "+document.getElementById("painting").value+
"%0ARequirement: "+document.getElementById("message").value+
"%0A%0AMujhe painting ka quotation chahiye.";

window.open(
"https://wa.me/917790889067?text="+encodeURIComponent(text),
"_blank"
);

}

</script>

