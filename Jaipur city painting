<script>

function sendWhatsApp(event){

event.preventDefault();

let text =
"Hello Pink City Colour Paint,%0A%0A"+
"Name: "+document.getElementById("name").value+
"%0AMobile: "+document.getElementById("mobile").value+
"%0AArea: "+document.getElementById("area").value+
